NODE_ENV=development
PORT=3000

GATEWAY_STORE_MODE=memory
# Local benchmark only; exact true is ignored when NODE_ENV=production.
GATEWAY_LOAD_TEST_MODE=false

PRICING_SERVICE_URL=http://pricing-service:3101
PAYMENT_SERVICE_URL=http://payment-service:3102
BOOKING_SERVICE_URL=http://booking-service:3103
AUTH_SERVICE_URL=http://auth-service:3104
USER_SERVICE_URL=http://user-service:3105
REVIEW_SERVICE_URL=http://review-service:3106
DRIVER_SERVICE_URL=http://driver-service:3107
NOTIFICATION_SERVICE_URL=http://notification-service:3108
RIDE_SERVICE_URL=http://ride-service:3109
ETA_SERVICE_URL=http://eta-service:3110
MATCHING_SERVICE_URL=http://matching-service:8000
REALTIME_INTERNAL_KEY=cab-realtime-internal-key
REALTIME_INTERNAL_KEY_FILE=

AUTH_JWKS_URL=http://auth-service:3104/.well-known/jwks.json
AUTH_ME_URL=http://auth-service:3104/api/v1/auth/me
AUTH_VALIDATION_TIMEOUT_MS=5000
JWT_ISSUER=cab-auth-service
JWT_AUDIENCE=cab-api

UPSTREAM_TIMEOUT_MS=5000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
