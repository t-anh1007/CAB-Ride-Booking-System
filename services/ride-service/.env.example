# Ride Service Configuration

# Port on which the service will run
PORT=3109

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Database Connection (when integrated)
# MONGODB_URI=mongodb://localhost:27017/cab_booking_ride
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=cab_booking
# DB_USER=user
# DB_PASSWORD=password

# Redis Connection (for cache/real-time updates)
# RIDE_REDIS_HOST=localhost
# RIDE_REDIS_PORT=6379
# RIDE_REDIS_PASSWORD=
# RIDE_REDIS_DB=0
# REDIS_URL=redis://localhost:6379

# Dedicated ETA service (independent AI service)
ETA_SERVICE_URL=http://localhost:3110
ETA_SERVICE_TIMEOUT_MS=2500

# Message Broker Configuration (for event publishing)
# RABBITMQ_URL=amqp://user:password@localhost:5672
# KAFKA_BROKERS=localhost:9092

# Service URLs for internal communication
BOOKING_SERVICE_URL=http://localhost:3103
DRIVER_SERVICE_URL=http://localhost:3107
NOTIFICATION_SERVICE_URL=http://localhost:3108

# Feature Flags
ENABLE_REAL_TIME_TRACKING=true
ENABLE_EVENT_PUBLISHING=true

# ETA Calculation (average speed in km/h)
AVG_DRIVER_SPEED=30

# Limits
MAX_ACTIVE_RIDES=10000
LOCATION_UPDATE_INTERVAL_MS=5000
