PORT=3108

NOTIFICATION_MONGODB_URI=mongodb://notification-mongodb:27017
NOTIFICATION_MONGODB_URI_FILE=
NOTIFICATION_MONGODB_DB=cab_booking_notification
NOTIFICATION_MONGODB_COLLECTION=notifications
NOTIFICATION_MONGODB_REQUIRED=true

NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_MS=200
NOTIFICATION_DEDUPE_WINDOW_MS=300000

KAFKA_BROKERS=kafka:9092
NOTIFICATION_EVENT_TOPICS=driver.assigned,ride.assigned,ride.status.changed,payment.failed,payment.success,payment.completed
NOTIFICATION_CONSUMER_GROUP=notification-service-consumer
REALTIME_EVENT_TOPICS=driver.location.updated,ride.status.changed,driver.assigned,ride.assigned
NOTIFICATION_REALTIME_CONSUMER_GROUP=notification-realtime-gateway
GATEWAY_REALTIME_PUBLISH_URL=http://api-gateway:3000/internal/realtime/publish
REALTIME_INTERNAL_KEY=cab-realtime-internal-key
REALTIME_INTERNAL_KEY_FILE=
