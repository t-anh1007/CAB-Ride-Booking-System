NODE_ENV=development
SERVICE_NAME=auth-service
PORT=3104
REQUEST_ID_HEADER=x-request-id

AUTH_DB_HOST=auth-postgres
AUTH_DB_PORT=5432
AUTH_DB_NAME=cab_booking_auth
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_PASSWORD_FILE=
AUTH_DB_MAX_POOL_SIZE=10

AUTH_REDIS_HOST=auth-redis
AUTH_REDIS_PORT=6379
AUTH_REDIS_PASSWORD=
AUTH_REDIS_PASSWORD_FILE=
AUTH_REDIS_DB=0
AUTH_REDIS_KEY_PREFIX=cab:auth:
AUTH_REDIS_RATE_LIMIT_PREFIX=ratelimit:auth
AUTH_REDIS_REVOKED_SESSION_PREFIX=session:revoked

AUTH_JWT_ISSUER=cab-auth-service
AUTH_JWT_AUDIENCE=cab-api
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_ACTIVE_KID=auth-key-local-1
AUTH_JWT_ACTIVE_PRIVATE_KEY_PEM_FILE=
AUTH_JWT_ACTIVE_PUBLIC_KEY_PEM_FILE=
AUTH_JWT_PREVIOUS_PUBLIC_KEY_PEM_FILE=
AUTH_ACCESS_TOKEN_TTL_MINUTES=120

AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESEND_COOLDOWN_SECONDS=1
AUTH_OTP_MAX_VERIFY_ATTEMPTS=5
AUTH_OTP_LOCK_WINDOW_SECONDS=300

AUTH_RATE_LIMIT_OTP_REQUEST_PER_MINUTE=1000
AUTH_RATE_LIMIT_OTP_VERIFY_PER_MINUTE=1000
AUTH_RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=1000
AUTH_RATE_LIMIT_MFA_CHALLENGE_PER_MINUTE=1000
AUTH_RATE_LIMIT_REFRESH_PER_MINUTE=1000
AUTH_ADMIN_MFA_ENCRYPTION_KEY=replace-with-a-strong-secret
AUTH_ADMIN_MFA_ENCRYPTION_KEY_FILE=
AUTH_BOOTSTRAP_ADMIN_PASSWORD_FILE=

NOTIFICATION_SERVICE_BASE_URL=http://notification-service:3108
USER_SERVICE_BASE_URL=http://user-service:3105
DRIVER_SERVICE_BASE_URL=http://driver-service:3107
