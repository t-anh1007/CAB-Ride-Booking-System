              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "protected",
                "customer"
              ]
            },
            "description": "Manual drill: stop auth-service or break JWKS upstream first. Expect 503 AUTH_SERVICE_UNAVAILABLE."
