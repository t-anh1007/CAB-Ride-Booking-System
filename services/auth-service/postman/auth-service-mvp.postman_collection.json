            },
            {
              "name": "[OTP Customer] Verify OTP",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                      "var body = pm.response.json();",
                      "var data = body.data || {};",
                      "pm.collectionVariables.set('accessToken', data.accessToken || '');",
                      "pm.environment.set('accessToken', data.accessToken || '');",
                      "pm.collectionVariables.set('refreshToken', data.refreshToken || '');",
                      "pm.environment.set('refreshToken', data.refreshToken || '');",
                      "pm.test('success envelope is valid', function () {",
                      "  pm.expect(body.success).to.eql(true);",
                      "  pm.expect(body.error).to.eql(null);",
                      "  pm.expect(body.meta.requestId).to.be.a('string').and.not.empty;",
                      "});",
                      "pm.test('customer auth payload contains token pair', function () {",
                      "  pm.expect(data.authStatus).to.eql('verified');",
                      "  pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
                      "  pm.expect(data.refreshToken).to.be.a('string').and.not.empty;",
                      "  pm.expect(data.tokenType).to.eql('Bearer');",
                      "});",
                      "pm.test('customer bootstrap metadata exists', function () {",
                      "  pm.expect(data.bootstrap).to.be.an('object');",
                      "  pm.expect(data.bootstrap.status).to.be.a('string');",
                      "});"
                    ]
                  }
                }
              ],
              "id": "56745738-ec20-4ef7-905a-588d03080a24",
              "request": {
                "method": "POST",
                "header": [
