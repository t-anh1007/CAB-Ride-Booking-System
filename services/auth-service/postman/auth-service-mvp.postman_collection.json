    {
      "name": "Session Lifecycle (JWT / OAuth2)",
      "item": [
        {
          "name": "Refresh",
          "item": [
            {
              "name": "[OAuth2] Refresh Customer Token",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "var _rtOld = pm.environment.get('refreshToken') || pm.collectionVariables.get('refreshToken') || '';",
                      "pm.collectionVariables.set('oldRefreshToken', _rtOld);",
                      "pm.environment.set('oldRefreshToken', _rtOld);"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                      "var body = pm.response.json();",
                      "var data = body.data || {};",
                      "pm.collectionVariables.set('accessToken', data.accessToken || '');",
                      "pm.environment.set('accessToken', data.accessToken || '');",
                      "pm.collectionVariables.set('refreshToken', data.refreshToken || '');",
                      "pm.environment.set('refreshToken', data.refreshToken || '');",
                      "pm.test('refresh rotation returns fresh token pair', function () {",
                      "  pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
                      "  pm.expect(data.refreshToken).to.be.a('string').and.not.empty;",
                      "  pm.expect(data.refreshToken).to.not.eql(pm.collectionVariables.get('oldRefreshToken'));",
                      "  pm.expect(data.tokenType).to.eql('Bearer');",
                      "});",
                      "pm.test('session id survives rotation', function () {",
                      "  pm.expect(data.sessionId).to.be.a('string').and.not.empty;",
                      "});"
                    ]
                  }
                }
              ],
              "id": "8d3fb995-dc14-45af-b87c-59481c27ede8",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                },
                "url": {
                  "raw": "{{gatewayBaseUrl}}/auth/refresh",
                  "host": [
                    "{{gatewayBaseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "refresh"
                  ]
                }
              },
              "response": [],
              "createdAt": "2026-04-09T20:59:31.000Z",
              "updatedAt": "2026-04-09T23:03:05.000Z",
