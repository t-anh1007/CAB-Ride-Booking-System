NODE_ENV=development
PORT=3105

# Storage mode: auto | postgresql | in-memory
USER_SERVICE_STORAGE=postgresql

# Leave empty to use the POSTGRES_* variables below.
DATABASE_URL=
DATABASE_URL_FILE=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cab_booking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PASSWORD_FILE=
POSTGRES_SSL=false

# Optional for architecture-only Kafka connectivity check.
KAFKA_BROKERS=localhost:9092
