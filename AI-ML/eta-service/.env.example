# ─────────────────────────────────────────────
# ETA AI Service – Environment Variables
# Copy to .env and fill in real values
# ─────────────────────────────────────────────

PORT=3110

# ── Redis (hot-store for ETA cache & driver locations) ──
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Routing Provider ──────────────────────────
# Choose one: osrm | graphhopper | googlemaps | mapbox
ROUTING_PROVIDER=osrm

# ── Traffic Provider ──────────────────────────
# Choose one: heuristic | none
TRAFFIC_PROVIDER=heuristic
DEFAULT_TRAFFIC_DELAY_FACTOR=1.0

# OSRM (self-hosted, free) – default
OSRM_BASE_URL=http://router.project-osrm.org

# GraphHopper (self-hosted or cloud)
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
GRAPHHOPPER_API_KEY=

# Google Maps Distance Matrix
GOOGLE_MAPS_API_KEY=

# Mapbox Directions
MAPBOX_ACCESS_TOKEN=

# ── Cache TTL ─────────────────────────────────
# Seconds to keep a cached ETA result
ETA_CACHE_TTL_SECONDS=30

# Seconds to keep a driver location in Redis
DRIVER_LOCATION_TTL_SECONDS=300

# ── ETA Heuristics ────────────────────────────
# Fallback average speed (km/h) when routing API is unavailable
FALLBACK_AVG_SPEED_KMH=30

# Minimum ETA to return (minutes)
ETA_MIN_MINUTES=1

# ── Bias Correction (AI adjustment) ──────────
# Factor applied to routing-provided duration (e.g. 1.15 adds 15% buffer)
ETA_BIAS_FACTOR=1.0
ETA_BIAS_FACTOR_MIN=0.85
ETA_BIAS_FACTOR_MAX=1.5
ETA_BIAS_PROFILE_TTL_SECONDS=86400

# ── Event-driven ETA lane (optional) ─────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=eta-service
KAFKA_CONSUMER_GROUP_ID=eta-service-driver-location
DRIVER_LOCATION_TOPIC=driver.location.updated
ETA_RESULT_TOPIC=eta.result
KAFKA_STARTUP_RETRY_BASE_MS=2000
KAFKA_STARTUP_RETRY_MAX_MS=30000
