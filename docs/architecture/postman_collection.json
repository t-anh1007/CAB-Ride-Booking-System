{
	"info": {
		"name": "CAB-BOOKING - End-to-End Flow (Customer App State)",
		"description": "Luồng End-to-End với trạng thái Customer App: Khởi tạo pickup, drop và distance một lần duy nhất. Giá tiền tính từ Pricing sẽ tự động truyền cho các API tiếp theo.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "otpCode",
			"value": ""
		},
		{
			"key": "driverOtpCode",
			"value": ""
		},
		{
			"key": "driverToken",
			"value": ""
		},
		{
			"key": "userId",
			"value": ""
		},
		{
			"key": "driverId",
			"value": "d24b3038-f1ab-4ab2-9e9d-16be02bd5eb2"
		},
		{
			"key": "bookingId",
			"value": ""
		},
		{
			"key": "rideId",
			"value": ""
		},
		{
			"key": "latest_price",
			"value": "0"
		},
		{
			"key": "pickup_address",
			"value": "12 Nguyen Van Bao, Go Vap"
		},
		{
			"key": "pickup_lat",
			"value": "10.823"
		},
		{
			"key": "pickup_lng",
			"value": "106.629"
		},
		{
			"key": "drop_address",
			"value": "Cho Ben Thanh, Quan 1"
		},
		{
			"key": "drop_lat",
			"value": "10.762"
		},
		{
			"key": "drop_lng",
			"value": "106.660"
		},
		{
			"key": "distance_km",
			"value": "5"
		}
	],
	"item": [
		{
			"name": "1a. Auth - Request OTP",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var res = pm.response.json();",
							"if (res.data && res.data.debugOtpCode) {",
							"    pm.collectionVariables.set('otpCode', res.data.debugOtpCode);",
							"    console.log('OTP Code saved:', res.data.debugOtpCode);",
							"} else {",
							"    console.error('Could not find debugOtpCode in response');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"destination\": \"0909123456\",\n  \"role\": \"customer\",\n  \"channel\": \"sms\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login/otp/request",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login",
						"otp",
						"request"
					]
				}
			}
		},
		{
			"name": "1b. Auth - Verify OTP → lấy token & userId",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var res = pm.response.json();",
							"if (!res.data) { console.error('No data in response'); return; }",
							"var token = (res.data.tokens && res.data.tokens.accessToken) || res.data.accessToken;",
							"if (token) { pm.collectionVariables.set('token', token); console.log('Token saved'); }",
							"if (res.data.account && res.data.account.subject_id) {",
							"    pm.collectionVariables.set('userId', res.data.account.subject_id);",
							"    console.log('userId saved:', res.data.account.subject_id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"destination\": \"0909123456\",\n  \"role\": \"customer\",\n  \"code\": \"{{otpCode}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login/otp/verify",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login",
						"otp",
						"verify"
					]
				}
			}
		},
		{
			"name": "2. Pricing - Calculate Fare (Customer enters Pickup/Drop)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var res = pm.response.json();",
							"if (res.success && res.data && res.data.priceSnapshot) {",
							"    pm.collectionVariables.set('latest_price', res.data.priceSnapshot.amount);",
							"    console.log('Đã tính và lưu giá mới từ Pricing Service:', res.data.priceSnapshot.amount);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"pickupAddress\": \"{{pickup_address}}\",\n  \"destinationAddress\": \"{{drop_address}}\",\n  \"distanceKm\": {{distance_km}},\n  \"durationMin\": 15,\n  \"vehicleType\": \"bike\",\n  \"demandIndex\": 1.2,\n  \"supplyIndex\": 1.0\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/pricing/quote",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"pricing",
						"quote"
					]
				}
			}
		},
		{
			"name": "3. Booking - Create Booking → lấy bookingId",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var res = pm.response.json();",
							"var id = res.data && (res.data.bookingId || res.data._id || res.data.id);",
							"if (id) {",
							"    pm.collectionVariables.set('bookingId', id);",
							"    console.log('bookingId saved:', id);",
							"} else {",
							"    console.error('bookingId NOT found');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Idempotency-Key",
						"value": "{{$guid}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"userId\": \"{{userId}}\",\n  \"pickup\": {\n    \"lat\": {{pickup_lat}},\n    \"lng\": {{pickup_lng}},\n    \"address\": \"{{pickup_address}}\"\n  },\n  \"drop\": {\n    \"lat\": {{drop_lat}},\n    \"lng\": {{drop_lng}},\n    \"address\": \"{{drop_address}}\"\n  },\n  \"vehicleType\": \"bike\",\n  \"distanceKm\": {{distance_km}},\n  \"paymentMethod\": \"CASH\",\n  \"priceSnapshot\": {\n    \"amount\": {{latest_price}},\n    \"currency\": \"VND\",\n    \"surgeMultiplier\": 1.2\n  }\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/bookings",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"bookings"
					]
				}
			}
		},
		{
			"name": "4a. Driver Auth - Request OTP",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var res = pm.response.json();",
							"if (res.data && res.data.debugOtpCode) {",
							"    pm.collectionVariables.set('driverOtpCode', res.data.debugOtpCode);",
							"    console.log('Driver OTP Code saved:', res.data.debugOtpCode);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"destination\": \"0908888777\",\n  \"role\": \"driver\",\n  \"channel\": \"sms\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login/otp/request",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login",
						"otp",
						"request"
					]
				}
			}
		},
		{
			"name": "4b. Driver Auth - Verify OTP → lấy driverToken",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var res = pm.response.json();",
							"if (!res.data) return;",
							"var token = (res.data.tokens && res.data.tokens.accessToken) || res.data.accessToken;",
							"if (token) { pm.collectionVariables.set('driverToken', token); console.log('Driver Token saved'); }",
							"if (res.data.account && res.data.account.subject_id) {",
							"    pm.collectionVariables.set('driverId', res.data.account.subject_id);",
							"    console.log('driverId saved:', res.data.account.subject_id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"destination\": \"0908888777\",\n  \"role\": \"driver\",\n  \"code\": \"{{driverOtpCode}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login/otp/verify",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login",
						"otp",
						"verify"
					]
				}
			}
		},
		{
			"name": "5. Driver - Sync Status",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{driverToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"phone\": \"0908888777\",\n  \"vehicleType\": \"bike\",\n  \"status\": \"OFFLINE\",\n  \"location\": {\n    \"lat\": {{pickup_lat}},\n    \"lng\": {{pickup_lng}},\n    \"address\": \"{{pickup_address}}\"\n  }\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/drivers/{{driverId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"drivers",
						"{{driverId}}"
					]
				}
			}
		},
		{
			"name": "6. Driver - Go Online",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{driverToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/drivers/{{driverId}}/go-online",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"drivers",
						"{{driverId}}",
						"go-online"
					]
				}
			}
		},
		{
			"name": "7. Ride - Create Ride → lấy rideId",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var res = pm.response.json();",
							"var id = res.data && (res.data.rideId || res.data._id || res.data.id);",
							"if (id) {",
							"    pm.collectionVariables.set('rideId', id);",
							"    console.log('rideId saved:', id);",
							"} else {",
							"    console.error('rideId NOT found');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"userId\": \"{{userId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"pickup\": {\n    \"lat\": {{pickup_lat}},\n    \"lng\": {{pickup_lng}},\n    \"address\": \"{{pickup_address}}\"\n  },\n  \"destination\": {\n    \"lat\": {{drop_lat}},\n    \"lng\": {{drop_lng}},\n    \"address\": \"{{drop_address}}\"\n  }\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/rides",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"rides"
					]
				}
			}
		},
		{
			"name": "8. Ride - Start Ride",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{driverToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"driverId\": \"{{driverId}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/rides/{{rideId}}/start",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"rides",
						"{{rideId}}",
						"start"
					]
				}
			}
		},
		{
			"name": "9. Ride - Complete Ride",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{driverToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"driverId\": \"{{driverId}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/rides/{{rideId}}/complete",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"rides",
						"{{rideId}}",
						"complete"
