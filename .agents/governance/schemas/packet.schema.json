{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cab.local/governance/packet.schema.json",
  "title": "Governance packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "goal", "acceptance_criteria", "state", "owner_id", "coordinator_id", "participants", "execution_complexity", "assurance_risk", "requested_runtime", "exact_path_allowlist", "baseline", "stop_gates", "expires_at", "events"],
  "properties": {
    "schema_version": { "const": 1 }, "id": { "type": "string", "minLength": 1 }, "goal": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "state": { "enum": ["DRAFT", "READY", "SPECIALIST_REVIEW", "WORKER_AUTHORIZED", "WRITING", "CANDIDATE_FROZEN", "AUDIT_REQUIRED", "AUDIT_SKIPPED", "COORDINATOR_REVIEW", "ACCEPTED", "REWORK", "STOPPED", "EXPIRED"] },
    "owner_id": { "type": "string" }, "coordinator_id": { "type": "string" },
    "participants": { "type": "object", "additionalProperties": false, "required": ["specialist", "worker", "auditor"], "properties": { "specialist": { "type": ["string", "null"] }, "worker": { "type": ["string", "null"] }, "auditor": { "type": ["string", "null"] } } },
    "execution_complexity": { "enum": ["EASY", "MEDIUM", "HARD"] }, "assurance_risk": { "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"] },
    "requested_runtime": { "type": "object", "additionalProperties": false, "required": ["model", "reasoning", "enforced"], "properties": { "model": { "enum": ["luna", "terra", "sol"] }, "reasoning": { "enum": ["medium", "high", "xhigh", "ultra"] }, "enforced": { "const": false }, "downgrade_rationale": { "type": "string", "minLength": 1 } } },
    "exact_path_allowlist": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "creation_allowed", "baseline_sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "creation_allowed": { "type": "boolean" }, "baseline_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" } } } },
    "baseline": { "type": "object", "additionalProperties": false, "required": ["git_head", "captured_at", "manifest_sha256"], "properties": { "git_head": { "type": ["string", "null"] }, "captured_at": { "type": "string", "format": "date-time" }, "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "stop_gates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "open", "reason"], "properties": { "code": { "type": "string" }, "open": { "type": "boolean" }, "reason": { "type": "string" }, "evidence_required": { "type": "array", "items": { "type": "string" } } } } },
    "expires_at": { "type": "string", "format": "date-time" }, "events": { "type": "array", "items": { "type": "object" } }, "candidate": { "type": "object" }, "finding_dispositions": { "type": "array", "items": { "type": "object" } }
  }
}
