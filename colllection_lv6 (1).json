        {
          "name": "TC54 - Agent goi dung tool ETA va Pricing",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{matching_base_url}}/api/v1/mcp/context/{{ride_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC54 context endpoint status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('TC54 goi ETA truoc, Pricing sau va ca hai thanh cong', function (done) {",
                  "  const ctx = pm.response.json() || {};",
                  "  const pickup = ctx.pickup || { lat: Number(pm.environment.get('pickup_lat')), lng: Number(pm.environment.get('pickup_lng')) };",
                  "  const drop = ctx.drop || { lat: Number(pm.environment.get('drop_lat')), lng: Number(pm.environment.get('drop_lng')) };",
                  "  const etaReq = {",
                  "    url: pm.environment.get('eta_base_url') + '/api/v1/eta/calculate',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ origin: pickup, destination: drop }) }",
                  "  };",
                  "  pm.sendRequest(etaReq, function (etaErr, etaRes) {",
                  "    pm.expect(etaErr).to.eql(null);",
                  "    pm.expect(etaRes.code).to.eql(200);",
                  "    const etaJson = etaRes.json();",
                  "    const etaMinutes = etaJson?.data?.etaMinutes;",
                  "    pm.environment.set('tc54_eta_minutes', String(etaMinutes || ''));",
                  "    const pricingReq = {",
                  "      url: pm.environment.get('pricing_base_url') + '/api/v1/pricing/quote',",
                  "      method: 'POST',",
                  "      header: { 'Content-Type': 'application/json' },",
                  "      body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "          destinationAddress: 'Level6 Destination',",
                  "          vehicleType: pm.environment.get('vehicle_type') || 'standard',",
                  "          pickupLat: Number(pickup.lat),",
                  "          pickupLng: Number(pickup.lng),",
                  "          dropLat: Number(drop.lat),",
                  "          dropLng: Number(drop.lng),",
                  "          distanceKm: 5,",
                  "          durationMin: Number(etaMinutes || 15)",
                  "        })",
                  "      }",
                  "    };",
                  "    pm.sendRequest(pricingReq, function (pricingErr, pricingRes) {",
                  "      pm.expect(pricingErr).to.eql(null);",
                  "      pm.expect([200, 503]).to.include(pricingRes.code);",
                  "      if (pricingRes.code === 200) {",
                  "        const price = pricingRes.json()?.data?.priceSnapshot?.amount;",
                  "        pm.environment.set('tc54_quote_amount', String(price || ''));",
                  "      }",
                  "      done();",
                  "    });",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
