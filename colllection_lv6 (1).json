        {
          "name": "TC56 - Agent retry khi service loi (ETA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{json_content_type}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": { \"lat\": {{pickup_lat}}, \"lng\": {{pickup_lng}} },\n  \"destination\": { \"lat\": {{drop_lat}}, \"lng\": {{drop_lng}} }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{eta_base_url}}{{tc56_eta_path}}",
            "description": "Goi ETA endpoint dung de xac nhan flow retry/fallback tren loi thuc te."
          },
          "event": [
              {
                "listen": "prerequest",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "const simulateFirstError = String(pm.environment.get('tc56_simulate_first_error') || 'true').toLowerCase() === 'true';",
                    "const retryCount = Number(pm.environment.get('tc56_retry_count') || '0');",
                    "const failPath = pm.environment.get('tc56_fail_path') || '/api/v1/eta/force-error';",
                    "const successPath = '/api/v1/eta/calculate';",
                    "if (simulateFirstError && retryCount === 0) {",
                    "  pm.environment.set('tc56_eta_path', failPath);",
                    "} else {",
                    "  pm.environment.set('tc56_eta_path', successPath);",
                    "}"
                  ]
                }
              },
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('TC56 retry when ETA service fails first attempt', function (done) {",
                    "  const simulateFirstError = String(pm.environment.get('tc56_simulate_first_error') || 'true').toLowerCase() === 'true';",
                    "  const currentRetryCount = Number(pm.environment.get('tc56_retry_count') || '0');",
                    "  const successPath = '/api/v1/eta/calculate';",
                    "  const payload = {",
                    "    origin: {",
                    "      lat: Number(pm.environment.get('pickup_lat')),",
                    "      lng: Number(pm.environment.get('pickup_lng'))",
                    "    },",
                    "    destination: {",
                    "      lat: Number(pm.environment.get('drop_lat')),",
                    "      lng: Number(pm.environment.get('drop_lng'))",
                    "    }",
                    "  };",
                    "  const token = pm.environment.get('token') || pm.environment.get('access_token') || '';",
                    "",
                    "  if (!simulateFirstError) {",
                    "    pm.expect(pm.response.code).to.eql(200);",
                    "    pm.environment.set('tc56_retry_count', '0');",
                    "    pm.environment.set('tc56_eta_path', successPath);",
                    "    return done();",
                    "  }",
                    "",
                    "  if (currentRetryCount === 0) {",
                    "    pm.expect(pm.response.code).to.not.eql(200);",
                    "    pm.environment.set('tc56_retry_count', '1');",
                    "    pm.environment.set('tc56_eta_path', successPath);",
                    "    const retryHeaders = { 'Content-Type': 'application/json' };",
                    "    if (token) {",
                    "      retryHeaders.Authorization = `Bearer ${token}`;",
                    "    }",
                    "    pm.sendRequest({",
                    "      url: pm.environment.get('eta_base_url') + successPath,",
                    "      method: 'POST',",
                    "      header: retryHeaders,",
                    "      body: { mode: 'raw', raw: JSON.stringify(payload) }",
                    "    }, function (err, res) {",
                    "      pm.expect(err).to.eql(null);",
                    "      pm.expect(res.code).to.eql(200);",
                    "      pm.environment.set('tc56_retry_count', '0');",
                    "      pm.environment.set('tc56_eta_path', successPath);",
                    "      done();",
                    "    });",
                    "    return;",
                    "  }",
                    "",
                    "  pm.expect(pm.response.code).to.eql(200);",
                    "  pm.environment.set('tc56_retry_count', '0');",
                    "  pm.environment.set('tc56_eta_path', successPath);",
                    "  done();",
                    "});"
                  ]
                }
              }
          ]
        },
