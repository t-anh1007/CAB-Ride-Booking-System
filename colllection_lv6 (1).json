                "type": "text/javascript",
                "exec": [
                  "pm.test('TC3 status 201', function(){ pm.response.to.have.status(201); });",
                  "const j = pm.response.json() || {};",
                  "const status = j?.data?.status || '';",
                  "pm.test('TC3 status REQUESTED/CONFIRMED-like', function(){ pm.expect(['REQUESTED','ASSIGNED','SEARCHING_DRIVER','ACCEPTED']).to.include(status); });",
                  "const bookingId = j?.data?.bookingId || '';",
                  "if (bookingId) pm.environment.set('booking_id', bookingId);"
                ]
