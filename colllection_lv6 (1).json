      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "const reqId = `pm-${now.getTime()}-${Math.floor(Math.random()*100000)}`;",
          "function ensureVar(key, value) {",
          "  const cur = pm.environment.get(key);",
          "  if (cur === undefined || cur === null || cur === '') {",
          "    pm.environment.set(key, String(value));",
          "  }",
          "}",
          "pm.environment.set('request_id', reqId);",
          "if (!pm.environment.get('token') && pm.environment.get('access_token')) { pm.environment.set('token', pm.environment.get('access_token')); }",
          "ensureVar('auth_base_url', 'http://localhost:3104');",
          "ensureVar('user_service_base_url', 'http://localhost:3105');",
          "ensureVar('booking_base_url', 'http://localhost:3103');",
          "ensureVar('driver_base_url', 'http://localhost:3107');",
          "ensureVar('notification_base_url', 'http://localhost:3108');",
          "ensureVar('eta_base_url', 'http://localhost:3000');",
          "ensureVar('pricing_base_url', 'http://localhost:3101');",
          "ensureVar('matching_base_url', 'http://localhost:8000');",
          "ensureVar('gateway_base_url', 'http://localhost:3000');",
          "ensureVar('vehicle_type', 'standard');",
          "ensureVar('pickup_lat', '10.762622');",
          "ensureVar('pickup_lng', '106.660172');",
          "ensureVar('drop_lat', '10.773170');",
          "ensureVar('drop_lng', '106.704820');",
          "ensureVar('auth_destination', '0912345678');",
          "ensureVar('auth_otp_code', '123456');",
          "ensureVar('driver_id', 'DRV001');",
          "ensureVar('max_retry_attempts', '2');",
          "ensureVar('tc56_simulate_first_error', 'true');",
          "ensureVar('tc56_retry_count', '0');",
          "ensureVar('tc56_eta_path', '/api/v1/eta/calculate');",
          "ensureVar('tc56_fail_path', '/api/v1/eta/force-error');",
          "ensureVar('tc59_parallel_requests', '5');",
          "if (!pm.environment.get('ride_id')) { pm.environment.set('ride_id', `ride-${now.getTime()}`); }",
          "if (!pm.environment.get('user_subject_id')) { pm.environment.set('user_subject_id', `usr-${now.getTime()}`); }",
          "if (!pm.environment.get('account_id')) { pm.environment.set('account_id', `acc-${now.getTime()}`); }",
          "if (!pm.environment.get('level1_booking_user_id')) { pm.environment.set('level1_booking_user_id', pm.environment.get('user_subject_id')); }",
