      "name": "Level 1 - Basic API & Flow (TC1-TC10)",
      "description": "Day du testcase Level 1 bam endpoint codebase hien tai.",
      "item": [
        {
          "name": "TC1 - Setup user context (seeded account)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_base_url}}/api/v1/auth/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC1 gateway/auth health 200', function(){ pm.response.to.have.status(200); });",
                  "pm.environment.set('level1_user_id', pm.environment.get('seed_customer_subject_id'));",
                  "pm.environment.set('level1_booking_user_id', pm.environment.get('seed_customer_subject_id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC2.1 - Dang nhap OTP request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{json_content_type}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"{{auth_destination}}\",\n  \"role\": \"customer\",\n  \"channel\": \"sms\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gateway_base_url}}/api/v1/auth/login/otp/request"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC2.1 status 202', function(){ pm.response.to.have.status(202); });",
                  "const j = pm.response.json() || {};",
                  "const debugCode = j?.data?.debugOtpCode;",
                  "if (debugCode) { pm.environment.set('auth_otp_code', String(debugCode)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "TC2.2 - Dang nhap OTP verify tra JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{json_content_type}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"{{auth_destination}}\",\n  \"role\": \"customer\",\n  \"code\": \"{{auth_otp_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gateway_base_url}}/api/v1/auth/login/otp/verify"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC2.2 status 200', function(){ pm.response.to.have.status(200); });",
                  "const j = pm.response.json() || {};",
                  "const access = j?.data?.accessToken || j?.data?.tokens?.accessToken || null;",
                  "const refresh = j?.data?.refreshToken || j?.data?.tokens?.refreshToken || null;",
                  "pm.test('TC2.2 co access token', function(){ pm.expect(access).to.be.a('string').and.not.empty; });",
                  "if (access) pm.environment.set('access_token', access);",
                  "if (access) pm.environment.set('token', access);",
                  "if (refresh) pm.environment.set('refresh_token', refresh);",
                  "try {",
                  "  if (access) {",
                  "    const payloadPart = access.split('.')[1];",
                  "    const normalized = payloadPart.replace(/-/g, '+').replace(/_/g, '/');",
                  "    const json = JSON.parse(atob(normalized));",
                  "    if (json && json.sub) {",
                  "      pm.environment.set('level1_user_id', json.sub);",
                  "      pm.environment.set('level1_booking_user_id', json.sub);",
                  "    }",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ]
        },
