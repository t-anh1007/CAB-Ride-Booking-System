                  "});",
                  "pm.test('TC59 xu ly nhieu request song song khong conflict', function (done) {",
                  "  const total = Number(pm.environment.get('tc59_parallel_requests') || '5');",
                  "  let completed = 0;",
                  "  let ok = 0;",
                  "  for (let i = 0; i < total; i++) {",
                  "    const req = {",
                  "      url: pm.environment.get('matching_base_url') + '/api/v1/matching/best-driver',",
                  "      method: 'POST',",
                  "      header: { 'Content-Type': 'application/json' },",
                  "      body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "          rideId: `${pm.environment.get('ride_id')}-tc59-${i}`,",
                  "          candidates: [",
                  "            { driver_id: `drv59_${i}_a`, distance_km: 2.5, driver_rating: 4.6 },",
                  "            { driver_id: `drv59_${i}_b`, distance_km: 3.5, driver_rating: 4.9 }",
                  "          ],",
                  "          max_distance_km: 6",
                  "        })",
                  "      }",
                  "    };",
                  "    pm.sendRequest(req, function (err, res) {",
                  "      completed += 1;",
                  "      if (!err && res && res.code === 200) { ok += 1; }",
                  "      if (completed === total) {",
                  "        pm.expect(ok).to.eql(total);",
                  "        pm.environment.set('tc59_success_count', String(ok));",
                  "        done();",
                  "      }",
                  "    });",
                  "  }",
                  "});"
                ]
              }
            }
          ]
