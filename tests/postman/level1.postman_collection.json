    {
      "name": "New Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Quote uses ETA and surge pricing\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "  const json = pm.response.json();\r",
              "  const data = json.data;\r",
              "\r",
              "\r",
              "  pm.expect(data.quoteId).to.exist;\r",
              "  pm.expect(data.priceSnapshot.amount).to.be.above(0);\r",
              "  pm.expect(data.priceSnapshot.surgeMultiplier).to.be.at.least(1);\r",
              "\r",
              "\r",
              "  pm.environment.set(\"quoteId\", data.quoteId);\r",
              "  pm.environment.set(\"lockedAmount\", data.priceSnapshot.amount);\r",
              "  pm.environment.set(\"distanceKm\", data.priceSnapshot.distance || data.distanceKm || 5);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"pickupAddress\": \"IUH\",\r\n  \"destinationAddress\": \"Ben Thanh\",\r\n  \"vehicleType\": \"bike\",\r\n  \"pickupLat\": 10.76,\r\n  \"pickupLng\": 106.66,\r\n  \"dropLat\": 10.77,\r\n  \"dropLng\": 106.70\r\n}\r\n",
          "options": {
