    {
      "name": "2. login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Customer login returns JWT\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "  const json = pm.response.json();\r",
              "  const token = json.data.accessToken || json.data.tokens?.accessToken;\r",
              "  const refresh = json.data.refreshToken || json.data.tokens?.refreshToken;\r",
              "  pm.expect(token).to.exist;\r",
              "  pm.expect(refresh).to.exist;\r",
              "\r",
              "\r",
              "  const payload = JSON.parse(Buffer.from(token.split(\".\")[1], \"base64\").toString());\r",
              "  pm.expect(payload.sub).to.exist;\r",
              "  pm.expect(payload.exp).to.exist;\r",
              "\r",
              "\r",
              "  pm.environment.set(\"customerAccessToken\", token);\r",
              "  pm.environment.set(\"customerRefreshToken\", refresh);\r",
              "  pm.environment.set(\"customerUserId\", json.data.account.subject_id);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"destination\": \"0909123456\",\r\n  \"role\": \"customer\",\r\n  \"code\": \"{{customerOtp}}\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login/otp/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login",
            "otp",
            "verify"
          ]
        }
      },
      "response": []
